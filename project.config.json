{
    "appid": "touristappid",
    "projectname": "pretzel",
    "compileType": "miniprogram",
    "miniprogramRoot": "frontend/miniprogram/",
    "setting": {
        "es6": true,
        "useCompilerPlugins": ["typescript"]
    },
    "packOptions": {
        "ignore": [
            {
                "type": "folder",
                "value": "node_modules"
            },
            {
                "type": "file",
                "value": "package.json"
            },
            {
                "type": "file",
                "value": "package-lock.json"
            },
            {
                "type": "file",
                "value": "tsconfig.json"
            },
            {
                "type": "file",
                "value": "README.md"
            }
        ]
    }
}
