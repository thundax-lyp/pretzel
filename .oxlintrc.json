{
    "$schema": "./frontend/admin/node_modules/oxlint/configuration_schema.json",
    "env": {
        "node": true
    },
    "rules": {
        "no-debugger": "error",
        "eqeqeq": "error"
    },
    "overrides": [
        {
            "files": ["frontend/miniprogram/**/*.ts"],
            "globals": {
                "wx": "readonly"
            }
        }
    ],
    "plugins": ["typescript", "oxc"]
}
