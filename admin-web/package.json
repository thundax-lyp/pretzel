{
    "name": "pretzel-admin-web",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "lint": "oxlint --deny-warnings && node ../scripts/check-structure.mjs",
        "preview": "vite preview",
        "test": "vitest run",
        "format": "prettier --write src *.json vite.config.ts",
        "format:check": "prettier --check src *.json vite.config.ts"
    },
    "dependencies": {
        "@ant-design/icons": "6.3.2",
        "@ant-design/pro-components": "3.1.15-9",
        "@tanstack/react-query": "5.101.2",
        "antd": "6.5.0",
        "dayjs": "1.11.21",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "react-router-dom": "7.18.5",
        "sm-crypto": "0.5.8"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "6.9.1",
        "@testing-library/react": "16.3.2",
        "@testing-library/user-event": "14.6.1",
        "@types/node": "^24.19.2",
        "@types/react": "18.3.31",
        "@types/react-dom": "18.3.7",
        "@vitejs/plugin-react": "^6.1.2",
        "fake-indexeddb": "6.2.5",
        "jsdom": "29.1.1",
        "oxlint": "^1.89.0",
        "prettier": "3.9.3",
        "typescript": "5.9.3",
        "vite": "^8.3.5",
        "vitest": "4.1.12"
    }
}
