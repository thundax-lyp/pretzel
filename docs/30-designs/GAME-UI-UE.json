{
    "schemaVersion": 1,
    "sources": [
        "../10-requirements/GAME-REQUIREMENTS.md",
        "CLIENT-DESIGN.md",
        "GAME-DESIGN.md",
        "DATA-DESIGN.md"
    ],
    "target": {
        "orientation": "portrait",
        "layoutUnit": "safe-area-relative",
        "visual": {
            "theme": "cartoon_animal_meadow",
            "board": "ivory_mahjong_faces_green_base_depth_shadow",
            "contrast": "readable_on_busy_background",
            "statusEncoding": ["icon", "label", "visual_state"]
        }
    },
    "initial": "start.loading",
    "screens": {
        "start": {
            "regions": [
                "brand",
                "animal_scene",
                "turtle_progress",
                "release_information",
                "age_badge"
            ],
            "states": {
                "loading": {
                    "INIT_OK": "home.ready",
                    "INIT_FAILED": "start.error"
                },
                "error": {
                    "RETRY": "start.loading"
                }
            }
        },
        "home": {
            "regions": [
                "settings",
                "weekly_zoo",
                "start_challenge",
                "collection",
                "leaderboard",
                "share",
                "reserve_inventory",
                "resume_prompt"
            ],
            "states": {
                "ready": {
                    "START": "game.level1",
                    "RESUME_FOUND": "home.resume"
                },
                "resume": {
                    "CONTINUE": "game.restore",
                    "ABANDON_CONFIRMED": "home.ready"
                }
            },
            "empty": {
                "weekly_zoo": "本周还没有动物，开始挑战吧"
            },
            "dataStates": [
                "loading",
                "empty_zoo",
                "ready",
                "error",
                "week_changed"
            ]
        },
        "game": {
            "regions": [
                "settings",
                "current_question",
                "next_question",
                "board",
                "temporary_storage",
                "slot",
                "props"
            ],
            "layout": {
                "next_question": {
                    "visibleWhen": "next_question_exists",
                    "emphasis": "secondary"
                },
                "board": {
                    "zOrder": "layer",
                    "hitTest": "uncovered_card_only",
                    "scalePreservesCoverage": true
                },
                "temporary_storage": {
                    "overflow": "scroll",
                    "boundedViewport": true,
                    "preserveBoardAndSlotAccess": true,
                    "tapAction": "RESTORE_BOARD",
                    "eligibility": "all_original_support_instances_at_original_coordinates_and_original_position_unoccupied",
                    "states": [
                        "free_restore",
                        "waiting_supports",
                        "position_occupied"
                    ]
                },
                "slot": {
                    "capacity": 7,
                    "ordering": "insertion_order"
                }
            },
            "states": {
                "level1": {
                    "LEVEL_PASSED": "game.level2_loading",
                    "RUN_FAILED": "game.result_pending"
                },
                "level2_loading": {
                    "CONFIG_OK": "game.level2",
                    "CONFIG_FAILED": "game.level2_error"
                },
                "level2_error": {
                    "RETRY": "game.level2_loading",
                    "ABANDON_CONFIRMED": "home.ready"
                },
                "level2": {
                    "RUN_PASSED": "game.result_pending",
                    "RUN_FAILED": "game.result_pending"
                },
                "restore": {
                    "SNAPSHOT_OK": "snapshot.confirmedState",
                    "SNAPSHOT_FAILED": "game.restore_error"
                },
                "restore_error": {
                    "RETRY": "game.restore",
                    "ABANDON_CONFIRMED": "home.ready"
                },
                "result_pending": {
                    "WIN_CONFIRMED": "game.win",
                    "LOSS_CONFIRMED": "game.loss",
                    "RETRY": "game.result_pending"
                },
                "win": {
                    "HOME": "home.ready",
                    "REPLAY": "game.level1"
                },
                "loss": {
                    "HOME": "home.ready",
                    "REPLAY": "game.level1"
                }
            },
            "operationStates": [
                "ready",
                "submitting",
                "animating",
                "offline",
                "syncing_original_operation",
                "version_conflict",
                "terminal"
            ]
        }
    },
    "overlays": {
        "policy": {
            "maxActive": 1,
            "dismissOnBackdrop": false,
            "blocksBoardInput": true,
            "pausesEffectiveTimer": true
        },
        "settings": {
            "from": ["home", "game"],
            "controls": [
                "music_volume",
                "sfx_volume",
                "feedback",
                "customer_service",
                "child_privacy"
            ],
            "gameOnly": ["abandon_challenge"],
            "persist": ["music_volume", "sfx_volume"]
        },
        "child_privacy": {
            "scroll": true,
            "closeTo": "origin_screen"
        },
        "abandon_challenge": {
            "confirm": "end_run_then_home",
            "cancel": "resume_same_run"
        },
        "collection": {
            "items": "permanently_unlocked_animals",
            "fields": ["icon", "name", "description", "is_new_this_week"],
            "sort": "catalog_id",
            "states": ["loading", "empty", "ready", "error"]
        },
        "leaderboard": {
            "tabs": ["current_week", "history"],
            "rowFields": [
                "rank",
                "player_display",
                "animals_received",
                "is_self"
            ],
            "highlightTop": 3,
            "limit": 100,
            "showSelfOutsideLimit": true,
            "states": ["loading", "empty", "ready", "error"]
        },
        "prop_acquisition": {
            "guard": "level == 2 && run_active && inventory == 0",
            "controls": ["prop_description", "watch_rewarded_video", "cancel"],
            "states": [
                "ready",
                "loading",
                "playing",
                "pending",
                "granted",
                "cancelled",
                "failed",
                "limit_reached",
                "unavailable",
                "inventory_full",
                "incomplete_video"
            ]
        },
        "animal_reward": {
            "guard": "unclaimed_win_reward",
            "revealCount": 1,
            "effect": "refresh_weekly_zoo_after_confirmed_claim",
            "states": [
                "eligible",
                "pending",
                "revealed",
                "already_claimed",
                "error"
            ]
        },
        "result": {
            "variants": {
                "pending": ["status", "retry"],
                "win": [
                    "panda_celebration",
                    "collection_changes",
                    "reserve_reward_selection",
                    "home",
                    "replay",
                    "share_win"
                ],
                "loss": [
                    "panda_failure",
                    "failure_reason",
                    "home",
                    "replay",
                    "share_loss"
                ]
            }
        },
        "remove_selection": {
            "guard": "level == 2 && run_active && usable_remove && slot_nonempty",
            "controls": ["select_1_to_3_slot_cards", "confirm", "cancel"],
            "states": [
                "selecting",
                "submitting",
                "pending_sync",
                "applied",
                "rejected"
            ],
            "cancelConsumes": false
        }
    },
    "rules": {
        "level1": {
            "cards": 12,
            "questions": 3,
            "propsEnabled": false
        },
        "level2": {
            "cards": 48,
            "questions": 12,
            "propsEnabled": true
        },
        "pickOrder": [
            "validate_active_run_and_card_origin",
            "move_same_instance_to_slot",
            "evaluate_whole_slot_eye_and_leg_sums",
            "if_match_clear_and_advance",
            "else_if_full_fail"
        ],
        "finalQuestion": "win_only_if_board_slot_and_temporary_storage_empty",
        "inputLock": ["animation", "pending_operation", "modal"],
        "discardLockedClicks": true,
        "props": {
            "remove": "select_1_to_3_slot_cards_then_append_in_slot_order_and_evaluate_slot",
            "invalidConsumes": false,
            "consumeOrder": ["run_inventory", "reserve"],
            "reservePerType": 1,
            "videoClaimsPerRun": 10,
            "correct": "repair_from_proven_history_and_replay_to_current_question_without_refunding_inventory",
            "repack": "rearrange_remaining_board_cards_with_complete_solution_and_protected_restore_anchors"
        },
        "shares": {
            "home": "zoo_snapshot",
            "win": "achievement",
            "loss": "help_request",
            "inRunReward": false,
            "homeRewardGate": "verified_share_success",
            "homeDailyClaimLimit": 3
        },
        "week": {
            "timezone": "Asia/Shanghai",
            "start": "Monday 00:00",
            "zoo": "actual_claims_in_week",
            "collection": "permanent"
        },
        "audio": {
            "events": ["ready_go", "match_pop", "win", "loss"],
            "pauseOnBackground": true,
            "replayPastEventsOnRestore": false
        }
    },
    "unresolved": [
        "leaderboard_population",
        "history_presentation",
        "level1_offline_and_templates",
        "first_time_tutorial",
        "remaining_leg_counter",
        "result_leaderboard_summary",
        "ad_after_leaderboard",
        "scheduled_difficulty",
        "rare_animal_effects",
        "release_information_exact_content",
        "platform_feedback_customer_service_and_ad_verification"
    ],
    "coverage": {
        "firstLaunch": [
            "loading",
            "initialization_error",
            "retry",
            "home_ready",
            "first_level_guidance",
            "level_one_passed",
            "level_two_loading",
            "level_two_error",
            "level_two_ready"
        ],
        "board": [
            "covered_pick_feedback",
            "slot_totals",
            "seventh_card_match",
            "seventh_card_fail",
            "last_question",
            "temporary_storage_overflow"
        ],
        "propFeedback": [
            "remove_selection",
            "correct_preview_and_result",
            "repack_preview_and_result",
            "no_proven_solution",
            "search_inconclusive",
            "no_consumption_on_rejection"
        ],
        "recovery": [
            "background_pause",
            "session_expired",
            "same_operation_retry",
            "restore_error",
            "abandon_confirm"
        ],
        "rewards": [
            "eligibility",
            "video_incomplete",
            "share_unverified",
            "pending",
            "inventory_full",
            "limit_reached",
            "duplicate_confirmation",
            "single_animal_reveal"
        ],
        "collectionAndRank": [
            "empty_zoo",
            "empty_collection",
            "first_unlock",
            "repeat_acquisition",
            "week_rollover",
            "current_rank",
            "history_rank",
            "request_error"
        ],
        "release": [
            "audio_resume",
            "feedback_availability",
            "customer_service_availability",
            "privacy_and_release_content",
            "safe_area",
            "48_card_touch_and_scroll"
        ]
    },
    "motion": {
        "deal": {
            "staggerMs": 12,
            "moveMs": 360,
            "inputLockMs": 1000,
            "trigger": "first_render_of_run_level_or_confirmed_repack"
        },
        "pick": {
            "flyMs": 280,
            "arrivalPopMs": 220,
            "trigger": "confirmed_snapshot"
        },
        "match": {
            "clearMs": 330,
            "particlesMs": 800,
            "trigger": "confirmed_question_advance"
        },
        "result": {
            "panelPopMs": 220,
            "success": "happy_panda_confetti",
            "failure": "sad_panda_panel_shake",
            "trigger": "confirmed_settlement"
        },
        "props": {
            "REMOVE": "gold_selection_checkmark_then_fly_to_temporary",
            "CORRECT": "confirmed_corrected_board_tilt_and_return",
            "REPACK": "confirmed_new_board_deal"
        },
        "coveredCard": {
            "shakeMs": 220,
            "blockingModal": false
        },
        "button": {
            "pressedScale": 0.96,
            "pressMs": 70,
            "releaseMs": 100
        },
        "restore": {
            "flyMs": 300,
            "destination": "original_board_position",
            "trigger": "confirmed_RESTORE_BOARD",
            "preserveZOrder": true
        }
    }
}
