# Public configuration example. Copy to .env and set private values.

# Authorized WeChat mini game AppID for local Cocos builds.
FLIP_ZOO_WECHAT_GAME_APP_ID=
FLIP_ZOO_WECHAT_TEST_APP_ID=
FLIP_ZOO_WECHAT_CLOUD_ENV=
FLIP_ZOO_WECHAT_TEST_CLOUD_ENV=
# Optional Creator 3.8.8 executable override. Leave unset to use the build default.
# COCOS_CREATOR_PATH=/absolute/path/to/CocosCreator
# node scripts/with-env.mjs --env-file .env -- npm --prefix miniprograms/flip-zoo run build:wechat

# Optional Flip Zoo share card. Set the approved image ID together with its URL.
FLIP_ZOO_SHARE_DEFAULT_TITLE=
FLIP_ZOO_SHARE_DEFAULT_IMAGE_ID=
FLIP_ZOO_SHARE_DEFAULT_IMAGE_URL=

# Flip Zoo WeChat Shop identifiers. Keep real values in the private root .env.
FLIP_ZOO_WECHAT_SHOP_APP_ID=

# Server-only gift configuration for flipZooFragments; never embed in client builds.
FLIP_ZOO_WECHAT_GAME_APP_SECRET=

# Cat gift configuration. Animal index 0 is fixed in code.
# Gift activity ID identifies the activity, not a player-facing claim URL.
FLIP_ZOO_CAT_GIFT_ACTIVITY_ID=
FLIP_ZOO_CAT_GIFT_PRODUCT_ID=
# Optional: leave empty to query the activity and use the first item matching the product.
FLIP_ZOO_CAT_GIFT_SKU_ID=
# Each gift costs 1000 fragments of the same animal.
FLIP_ZOO_CAT_GIFT_FRAGMENT_COST=1000

# 吉娃娃: redemption stays closed until this group is configured and valid.
FLIP_ZOO_CHIHUAHUA_GIFT_ACTIVITY_ID=
FLIP_ZOO_CHIHUAHUA_GIFT_PRODUCT_ID=
FLIP_ZOO_CHIHUAHUA_GIFT_SKU_ID=
FLIP_ZOO_CHIHUAHUA_GIFT_FRAGMENT_COST=1000

# 卡皮巴拉: redemption stays closed until this group is configured and valid.
FLIP_ZOO_CAPYBARA_GIFT_ACTIVITY_ID=
FLIP_ZOO_CAPYBARA_GIFT_PRODUCT_ID=
FLIP_ZOO_CAPYBARA_GIFT_SKU_ID=
FLIP_ZOO_CAPYBARA_GIFT_FRAGMENT_COST=1000

# 小黄鸭: redemption stays closed until this group is configured and valid.
FLIP_ZOO_DUCK_GIFT_ACTIVITY_ID=
FLIP_ZOO_DUCK_GIFT_PRODUCT_ID=
FLIP_ZOO_DUCK_GIFT_SKU_ID=
FLIP_ZOO_DUCK_GIFT_FRAGMENT_COST=1000

# 招财羊: redemption stays closed until this group is configured and valid.
FLIP_ZOO_SHEEP_GIFT_ACTIVITY_ID=
FLIP_ZOO_SHEEP_GIFT_PRODUCT_ID=
FLIP_ZOO_SHEEP_GIFT_SKU_ID=
FLIP_ZOO_SHEEP_GIFT_FRAGMENT_COST=1000

# 鸡肚猪: redemption stays closed until this group is configured and valid.
FLIP_ZOO_PIG_GIFT_ACTIVITY_ID=
FLIP_ZOO_PIG_GIFT_PRODUCT_ID=
FLIP_ZOO_PIG_GIFT_SKU_ID=
FLIP_ZOO_PIG_GIFT_FRAGMENT_COST=1000
