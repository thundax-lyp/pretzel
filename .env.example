# Public configuration example. Copy to dev.env and set private values.
DB_PASSWORD=replace-with-local-password
DB_URL=jdbc:mysql://127.0.0.1:3306/pretzel?serverTimezone=Asia/Shanghai
DB_USERNAME=pretzel
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PASSWORD=
PRETZEL_BOOTSTRAP_ENABLED=false
PRETZEL_BOOTSTRAP_USERNAME=admin
# Set your own password when explicitly enabling first-run bootstrap. No default password.
PRETZEL_BOOTSTRAP_PASSWORD=
SERVER_PORT=8080
