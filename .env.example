# Public configuration example. Copy to .env (Cocos) or dev.env (backend) and set private values.
DB_PASSWORD=replace-with-local-password
DB_URL=jdbc:mysql://127.0.0.1:3306/pretzel?serverTimezone=Asia/Shanghai
DB_USERNAME=pretzel
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PASSWORD=
PRETZEL_BOOTSTRAP_ENABLED=false
PRETZEL_BOOTSTRAP_USERNAME=admin
# Set your own password when explicitly enabling first-run bootstrap. No default password.
PRETZEL_BOOTSTRAP_PASSWORD=
SERVER_PORT=8080

# Authorized WeChat mini game AppID for local Cocos builds.
WECHAT_GAME_APP_ID=
FLIP_ZOO_WECHAT_GAME_APP_ID=
FLIP_ZOO_WECHAT_TEST_APP_ID=
FLIP_ZOO_WECHAT_CLOUD_ENV=
FLIP_ZOO_WECHAT_TEST_CLOUD_ENV=
# Optional Creator 3.8.8 executable override. Leave unset to use the build default.
# COCOS_CREATOR_PATH=/absolute/path/to/CocosCreator
# python3 scripts/with-env.py --env-file .env -- npm --prefix frontend/miniprograms/eyes-and-legs run build:wechat

# Optional Flip Zoo share cards. Set each approved image ID together with its URL.
FLIP_ZOO_SHARE_DEFAULT_TITLE=
FLIP_ZOO_SHARE_DEFAULT_IMAGE_ID=
FLIP_ZOO_SHARE_DEFAULT_IMAGE_URL=
FLIP_ZOO_SHARE_VICTORY_TITLE=
FLIP_ZOO_SHARE_VICTORY_IMAGE_ID=
FLIP_ZOO_SHARE_VICTORY_IMAGE_URL=
